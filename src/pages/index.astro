---
import Layout from "../layouts/Layout.astro";
import SearchFilter from "../components/SearchFilter.astro";
import { SITE_DESCRIPTION, POSTS_PER_PAGE } from "../config";
import { getCollection } from "astro:content";
import "../styles/post-list.css";

const posts = await getCollection("posts");
posts.sort((a, b) => b.data.pubDatetime.getTime() - a.data.pubDatetime.getTime());

const allTags = [...new Set(posts.flatMap((p) => p.data.tags ?? []))].sort();
const pagePosts = posts.slice(0, POSTS_PER_PAGE);
const totalPages = Math.ceil(posts.length / POSTS_PER_PAGE);
---

<Layout>
  <section class="intro">
    <h1>{SITE_DESCRIPTION}</h1>
  </section>

  <SearchFilter allTags={allTags} />

  <section class="posts">
    {pagePosts.map((post) => (
      <article data-title={post.data.title.toLowerCase()} data-tags={(post.data.tags ?? []).join(",").toLowerCase()}>
        <time datetime={post.data.pubDatetime.toISOString()}>
          {post.data.pubDatetime.toLocaleDateString("zh-CN", { year: "numeric", month: "2-digit", day: "2-digit" })}
        </time>
        <a href={`/posts/${post.slug}/`}>{post.data.title}</a>
        {post.data.tags && (
          <span class="tags">
            {post.data.tags.map((tag) => (
              <span class="tag">{tag}</span>
            ))}
          </span>
        )}
      </article>
    ))}
  </section>

  <nav class="pagination">
    {totalPages > 1 && (
      <>
        <span class="page-disabled">上一页</span>
        <span class="page-info">1/{totalPages}</span>
        <a href="/page/2/">下一页</a>
      </>
    )}
  </nav>
</Layout>
