---
import type { CollectionEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import SearchFilter from "../../components/SearchFilter.astro";
import Pagination from "../../components/Pagination.astro";
import { SITE_DESCRIPTION, POSTS_PER_PAGE } from "../../config";
import { getCollection } from "astro:content";
import "../../styles/post-list.css";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  posts.sort((a, b) => b.data.pubDatetime.getTime() - a.data.pubDatetime.getTime());
  const totalPages = Math.ceil(posts.length / POSTS_PER_PAGE);
  return Array.from({ length: totalPages - 1 }, (_, i) => ({
    params: { page: String(i + 2) },
    props: { page: i + 2, totalPages, posts, allTags: [...new Set(posts.flatMap((p) => p.data.tags ?? []))].sort() },
  }));
}

type Props = {
  page: number;
  totalPages: number;
  posts: CollectionEntry<"posts">[];
  allTags: string[];
};

const { page, totalPages, posts: allPosts, allTags } = Astro.props;
const start = (page - 1) * POSTS_PER_PAGE;
const pagePosts = allPosts.slice(start, start + POSTS_PER_PAGE);
---

<Layout>
  <section class="intro" transition:name="home-intro" transition:persist>
    <h1>{SITE_DESCRIPTION}</h1>
  </section>

  <div transition:name="search-filter" transition:persist>
    <SearchFilter allTags={allTags} />
  </div>

  <section class="posts" transition:name="posts">
    {pagePosts.map((post) => (
      <article data-title={post.data.title.toLowerCase()} data-tags={(post.data.tags ?? []).join(",").toLowerCase()}>
        <time datetime={post.data.pubDatetime.toISOString()}>
          {post.data.pubDatetime.toLocaleDateString("zh-CN", { year: "numeric", month: "2-digit", day: "2-digit" })}
        </time>
        <a href={`/posts/${post.slug}/`}>{post.data.title}</a>
        {post.data.tags && (
          <span class="tags">
            {post.data.tags.map((tag) => (
              <span class="tag">{tag}</span>
            ))}
          </span>
        )}
      </article>
    ))}
  </section>

  <div transition:name="pagination" transition:animate="none">
    <Pagination currentPage={page} totalPages={totalPages} />
  </div>
</Layout>
