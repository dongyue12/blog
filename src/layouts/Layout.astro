---
import { SITE_TITLE, SITE_DESCRIPTION } from "../config";
import "../styles/global.css";

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
}

const { title, description, image = "/avatar.webp", type = "website" } = Astro.props;
const pageTitle = title ? `${title} — ${SITE_TITLE}` : SITE_TITLE;
const pageDesc = description ?? SITE_DESCRIPTION;
const site = Astro.site ?? new URL("https://dongyue.org");
const url = new URL(Astro.url.pathname, site);
const ogImage = new URL(image, site);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={pageDesc} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:url" content={url.href} />
    <meta property="og:type" content={type} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="dns-prefetch" href="https://www.clarity.ms" />
    <link rel="dns-prefetch" href="https://giscus.app" />
    <link rel="preconnect" href="https://www.clarity.ms" />
    <link rel="preconnect" href="https://giscus.app" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header>
      <nav>
        <a href="/" class="site-title">
          <img src="/avatar.webp" alt="avatar" class="site-avatar" />
          {SITE_TITLE}
        </a>
        <div class="nav-links">
          <a href="/rss.xml" class="rss-link" aria-label="RSS">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/></svg>
          </a>
          <button id="theme-toggle" aria-label="Toggle theme">☾</button>
          <a href="/links/">Links</a>
        </div>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <p>&copy; {new Date().getFullYear()} {SITE_TITLE}</p>
    </footer>
    <button id="back-to-top" aria-label="Back to top">↑</button>
    <script>
      const html = document.documentElement;
      const themeBtn = document.getElementById("theme-toggle");
      const topBtn = document.getElementById("back-to-top");

      const saved = localStorage.getItem("theme");
      if (saved) {
        html.dataset.theme = saved;
      }

      if (themeBtn) {
        themeBtn.textContent = html.dataset.theme === "dark" ? "☀" : "☾";

        themeBtn.addEventListener("click", () => {
          const next = html.dataset.theme === "dark" ? "light" : "dark";
          html.dataset.theme = next;
          localStorage.setItem("theme", next);
          themeBtn.textContent = next === "dark" ? "☀" : "☾";
        });
      }

      if (topBtn) {
        let ticking = false;
        addEventListener("scroll", () => {
          if (!ticking) {
            requestAnimationFrame(() => {
              topBtn.classList.toggle("show", scrollY > 300);
              ticking = false;
            });
            ticking = true;
          }
        });

        topBtn.addEventListener("click", () => {
          scrollTo({ top: 0, behavior: "smooth" });
        });
      }
    </script>
    <script defer type="text/javascript">
      /* eslint-disable prefer-rest-params */
      (function(c,l,a,r,i,t,y){
          c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
          t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
          y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "wt6w5de1uw");
      /* eslint-enable prefer-rest-params */
    </script>
  </body>
</html>

<style is:global>
  header {
    padding: 2rem 1.5rem 1.5rem;
    max-width: var(--max-w);
    margin: 0 auto;
  }

  header nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .site-title {
    text-decoration: none;
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--fg);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .site-avatar {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    font-size: 0.95rem;
    flex-shrink: 0;
  }

  .nav-links a {
    text-decoration: none;
    color: var(--muted);
    transition: color 0.15s;
  }

  .nav-links a:hover {
    color: var(--fg);
  }

  .rss-link {
    display: flex;
    align-items: center;
    text-decoration: none;
    color: var(--muted);
    transition: color 0.15s;
  }

  .rss-link:hover {
    color: var(--fg);
  }

  #theme-toggle {
    background: none;
    border: none;
    cursor: pointer;
    font-size: 1rem;
    line-height: 1;
    padding: 0;
    color: var(--muted);
    transition: color 0.15s;
  }

  #theme-toggle:hover {
    color: var(--fg);
  }

  main {
    max-width: var(--max-w);
    margin: 0 auto;
    padding: 0 1.5rem 3rem;
  }

  footer {
    max-width: var(--max-w);
    margin: 0 auto;
    padding: 1.5rem 1.5rem 3rem;
    font-size: 0.85rem;
    color: var(--muted);
  }

  footer p {
    margin: 0;
  }

  #back-to-top {
    position: fixed;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    width: 2.2rem;
    height: 2.2rem;
    font-size: 1.1rem;
    color: var(--muted);
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 6px;
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.2s, visibility 0.2s, color 0.15s, background 0.15s;
    z-index: 99;
    line-height: 1;
  }

  #back-to-top.show {
    opacity: 1;
    visibility: visible;
  }

  #back-to-top:hover {
    color: var(--fg);
    background: var(--border);
  }

  @media (max-width: 640px) {
    header {
      padding: 1.25rem 1rem 1rem;
    }

    .site-title {
      font-size: 0.95rem;
    }

    .nav-links {
      gap: 0.9rem;
      font-size: 0.85rem;
    }

    #theme-toggle {
      font-size: 0.9rem;
    }

    main {
      padding: 0 1rem 2rem;
    }

    footer {
      padding: 1rem 1rem 2rem;
      font-size: 0.8rem;
    }

    #back-to-top {
      bottom: 1rem;
      width: 2rem;
      height: 2rem;
      font-size: 1rem;
    }
  }
</style>
